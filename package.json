{
    "name": "met-formio",
    "version": "3.0.0-rc1",
    "private": false,
    "description": "React Formio Components for the Modern Engagement Tools project.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bcgov/met-formio.git"
    },
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./lib/*": "./lib/*",
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "test:coverage": "nyc --reporter=text mocha",
        "test": "mocha",
        "watch": "tsc -w",
        "build": "tsc && node scripts/build-templates.js && sass ./src/sass/contrib.scss ./dist/met-formio-components.css",
        "clean": "rm -rf coverage dist lib",
        "prepack": "npm run clean && npm run build",
        "purge": "rm -rf node_modules",
        "lint": "eslint src"
    },
    "files": [
        "dist",
        "lib"
    ],
    "keywords": [
        "Form.io",
        "components"
    ],
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "dependencies": {
        "@formio/js": "^5.3.0",
        "@react-querybuilder/bootstrap": "^8",
        "lodash": "^4.18.1",
        "react-querybuilder": "^8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^4.2.22",
        "@types/jsdom": "^30.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.2.0",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "chai": "^4.3.4",
        "eslint": "^10.8.1",
        "jsdom": "^29.1.1",
        "mocha": "^10.8.2",
        "nyc": "^18.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sass": "^1.102.0",
        "ts-node": "^10.4.0",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.67.0"
    }
}
